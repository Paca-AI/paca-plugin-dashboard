{
  "id": "com.paca.dashboard",
  "displayName": "Dashboard",
  "description": "Customizable panel-based dashboard builder (charts, tables, text) across the project dashboard page, the admin dashboard page, and a single dashboard per Integration-page view (backlog/sprint/timeline).",
  "version": "0.4.0",
  "minCoreVersion": "v0.13.3",
  "permissions": ["db.read", "db.write", "events.subscribe", "cache"],
  "customPermissions": [
    {
      "key": "dashboard:view",
      "scope": "both",
      "label": "View dashboard",
      "description": "View the Dashboard page and its panels. Grant on a project resource for the project dashboard, or on a global resource for the instance-wide cross-project dashboard."
    },
    {
      "key": "dashboard:manage",
      "scope": "both",
      "label": "Manage dashboard",
      "description": "Create, edit, delete, and rearrange panels on a Dashboard page, and run query previews while authoring them. Grant on a project resource for the project dashboard, or on a global resource for the instance-wide dashboard."
    }
  ],
  "backend": {
    "eventSubscriptions": [],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/view",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:view"] }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/view/:hostViewId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:view"] }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/views/:viewId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/layout",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId/data",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/query/preview",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "project", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "GET",
        "path": "/dashboard/admin-view",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "global", "actions": ["dashboard:view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-view/panels",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "global", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/dashboard/admin-view/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "global", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "DELETE",
        "path": "/dashboard/admin-view/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "global", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/dashboard/admin-view/panels/layout",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "global", "actions": ["dashboard:manage"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-view/panels/:panelId/data",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "global", "actions": ["dashboard:view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-query/preview",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requireActions", "scope": "global", "actions": ["dashboard:manage"] }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.dashboard/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.page",
        "component": "ProjectDashboardPage",
        "order": 5
      },
      {
        "point": "admin.page",
        "component": "AdminDashboardPage",
        "order": 5
      },
      {
        "point": "view",
        "component": "DashboardIntegrationView",
        "label": "Dashboard",
        "order": 5
      }
    ],
    "navItems": [
      {
        "scope": "project",
        "slug": "dashboard",
        "label": "Dashboard",
        "icon": "LayoutDashboard",
        "component": "ProjectDashboardPage",
        "order": 5,
        "requiredPermission": "dashboard:view"
      },
      {
        "scope": "admin",
        "slug": "dashboard",
        "label": "Dashboard",
        "icon": "LayoutDashboard",
        "component": "AdminDashboardPage",
        "order": 5,
        "requiredPermission": "dashboard:view"
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.paca.dashboard/mcp.js"
  },
  "skills": {
    "baseUrl": "/plugins-skills/com.paca.dashboard",
    "names": ["paca-dashboard-builder"]
  }
}
