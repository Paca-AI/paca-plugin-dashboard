{
  "id": "com.paca.dashboard",
  "displayName": "Dashboard",
  "description": "Customizable panel-based dashboard builder (charts, tables, text) across the project dashboard page, the admin dashboard page, and a single dashboard per Integration-page view (backlog/sprint/timeline).",
  "version": "0.4.0",
  "minCoreVersion": "v0.13.3",
  "permissions": ["db.read", "db.write", "events.subscribe", "cache"],
  "customPermissions": [
    {
      "key": "dashboard.view",
      "label": "View dashboard",
      "description": "View the project's \"Dashboard\" page and its panels. Does not affect the per-view dashboards embedded in Backlog/Sprint/Timeline pages, which any project member can already see.",
      "scope": "project"
    },
    {
      "key": "dashboard.manage",
      "label": "Manage dashboard",
      "description": "Create, edit, delete, and rearrange panels on the project's \"Dashboard\" page, and run query previews while authoring them.",
      "scope": "project"
    },
    {
      "key": "dashboard.view",
      "label": "View dashboard",
      "description": "View the admin-sidebar \"Dashboard\" page — the instance-wide, cross-project dashboard.",
      "scope": "global"
    },
    {
      "key": "dashboard.manage",
      "label": "Manage dashboard",
      "description": "Create, edit, delete, and rearrange panels on the admin-sidebar \"Dashboard\" page, and run query previews while authoring them.",
      "scope": "global"
    }
  ],
  "backend": {
    "eventSubscriptions": [],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/view",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/view/:hostViewId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/views/:viewId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/layout",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId/data",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/query/preview",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "GET",
        "path": "/dashboard/admin-view",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-view/panels",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["dashboard.manage"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/dashboard/admin-view/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["dashboard.manage"] }
        ]
      },
      {
        "method": "DELETE",
        "path": "/dashboard/admin-view/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["dashboard.manage"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/dashboard/admin-view/panels/layout",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["dashboard.manage"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-view/panels/:panelId/data",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["dashboard.view"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-query/preview",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["dashboard.manage"] }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.dashboard/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.page",
        "component": "ProjectDashboardPage",
        "order": 5
      },
      {
        "point": "admin.page",
        "component": "AdminDashboardPage",
        "order": 5
      },
      {
        "point": "view",
        "component": "DashboardIntegrationView",
        "label": "Dashboard",
        "order": 5
      }
    ],
    "navItems": [
      {
        "scope": "project",
        "slug": "dashboard",
        "label": "Dashboard",
        "icon": "LayoutDashboard",
        "component": "ProjectDashboardPage",
        "order": 5,
        "requiredPermission": "dashboard.view"
      },
      {
        "scope": "admin",
        "slug": "dashboard",
        "label": "Dashboard",
        "icon": "LayoutDashboard",
        "component": "AdminDashboardPage",
        "order": 5,
        "requiredPermission": "dashboard.view"
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.paca.dashboard/mcp.js"
  },
  "skills": {
    "baseUrl": "/plugins-skills/com.paca.dashboard",
    "names": ["paca-dashboard-builder"]
  }
}
