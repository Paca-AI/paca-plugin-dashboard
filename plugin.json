{
  "id": "com.paca.dashboard",
  "displayName": "Dashboard",
  "description": "Customizable panel-based dashboard builder (charts, tables, text) across the project dashboard page, the admin dashboard page, and a single dashboard per Integration-page view (backlog/sprint/timeline).",
  "version": "0.3.0",
  "minCoreVersion": "v0.11.2",
  "permissions": ["db.read", "db.write", "events.subscribe", "cache"],
  "backend": {
    "eventSubscriptions": [],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/view",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.read"] }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/view/:hostViewId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.read"] }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/dashboard/views/:viewId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.read"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.write"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.write"] }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.write"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/layout",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.write"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/views/:viewId/panels/:panelId/data",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.read"] }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/dashboard/query/preview",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "project", "permissions": ["projects.write"] }
        ]
      },
      {
        "method": "GET",
        "path": "/dashboard/admin-view",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["users.write"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-view/panels",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["users.write"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/dashboard/admin-view/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["users.write"] }
        ]
      },
      {
        "method": "DELETE",
        "path": "/dashboard/admin-view/panels/:panelId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["users.write"] }
        ]
      },
      {
        "method": "PATCH",
        "path": "/dashboard/admin-view/panels/layout",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["users.write"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-view/panels/:panelId/data",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["users.write"] }
        ]
      },
      {
        "method": "POST",
        "path": "/dashboard/admin-query/preview",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          { "name": "requirePermissions", "scope": "global", "permissions": ["users.write"] }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.dashboard/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.page",
        "component": "ProjectDashboardPage",
        "order": 5
      },
      {
        "point": "admin.page",
        "component": "AdminDashboardPage",
        "order": 5
      },
      {
        "point": "view",
        "component": "DashboardIntegrationView",
        "label": "Dashboard",
        "order": 5
      }
    ],
    "navItems": [
      {
        "scope": "project",
        "slug": "dashboard",
        "label": "Dashboard",
        "icon": "LayoutDashboard",
        "component": "ProjectDashboardPage",
        "order": 5
      },
      {
        "scope": "admin",
        "slug": "dashboard",
        "label": "Dashboard",
        "icon": "LayoutDashboard",
        "component": "AdminDashboardPage",
        "order": 5
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.paca.dashboard/mcp.js"
  },
  "skills": {
    "baseUrl": "/plugins-skills/com.paca.dashboard",
    "names": ["paca-dashboard-builder"]
  }
}
